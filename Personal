Sub 上黃色()
'
' 上黃色 巨集
'
' 快速鍵: Ctrl+Shift+C
'
    Dim cell As Range
    For Each cell In Selection
        If cell.Interior.Color = RGB(255, 255, 0) Then
            cell.Interior.Pattern = xlNone
        Else
            cell.Interior.Color = RGB(255, 255, 0)
        End If
    Next cell
End Sub
