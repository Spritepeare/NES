Private Function NormalizeText(ByVal textData As String) As String
    Dim result As String

    result = Trim$(textData)
    result = Replace(result, vbCr, vbNullString)
    result = Replace(result, vbLf, vbNullString)
    result = Replace(result, vbTab, vbNullString)
    result = Replace(result, Chr$(160), vbNullString)
    result = Replace(result, ChrW(&H3000), vbNullString)
    result = Replace(result, " ", vbNullString)

    NormalizeText = UCase$(result)
End Function

Private Function IsMonthHeaderRow(ByVal ws As Worksheet, ByVal rowNumber As Long) As Boolean
    Dim c As Long
    Dim monthHeaderCount As Long
    Dim headerText As String

    For c = 2 To 19
        headerText = NormalizeText(GetCellText(ws.Cells(rowNumber, c)))

        If InStr(1, headerText, NormalizeText("月份下單"), vbTextCompare) > 0 Then
            monthHeaderCount = monthHeaderCount + 1
        End If
    Next c

    If monthHeaderCount >= 3 Then
        IsMonthHeaderRow = True
    ElseIf NormalizeText(GetCellText(ws.Cells(rowNumber, 20))) = NormalizeText("3個月平均") Then
        IsMonthHeaderRow = True
    End If
End Function

Private Function IsActualOrderLabel(ByVal labelText As String) As Boolean
    Dim key As String
    key = NormalizeText(labelText)

    If Left$(key, Len(NormalizeText("實際下單"))) = NormalizeText("實際下單") _
       And InStr(1, key, NormalizeText("跟上月預估"), vbTextCompare) = 0 Then
        IsActualOrderLabel = True
    End If
End Function

Private Function TryParseForecastLabel( _
    ByVal labelText As String, ByRef forecastYear As Long, ByRef forecastMonth As Long) As Boolean

    Dim key As String
    Dim token As String

    forecastYear = 0
    forecastMonth = 0
    key = NormalizeText(labelText)

    If Len(key) < 8 Then Exit Function
    If Right$(key, Len(NormalizeText("預估"))) <> NormalizeText("預估") Then Exit Function

    token = Left$(key, 6)
    If Not IsNumeric(token) Then Exit Function

    forecastYear = CLng(Left$(token, 4))
    forecastMonth = CLng(Right$(token, 2))

    If forecastYear >= 1900 And forecastMonth >= 1 And forecastMonth <= 12 Then
        TryParseForecastLabel = True
    End If
End Function

Private Function ExtractActualMonth(ByVal labelText As String) As Long
    Dim key As String
    Dim startPosition As Long, endPosition As Long
    Dim token As String

    key = NormalizeText(labelText)
    startPosition = InStr(1, key, NormalizeText("實際下單"), vbTextCompare)
    endPosition = InStr(1, key, NormalizeText("月份"), vbTextCompare)

    If startPosition > 0 And endPosition > startPosition Then
        startPosition = startPosition + Len(NormalizeText("實際下單"))
        token = Mid$(key, startPosition, endPosition - startPosition)

        If IsNumeric(token) Then
            ExtractActualMonth = CLng(token)
            If ExtractActualMonth < 1 Or ExtractActualMonth > 12 Then ExtractActualMonth = 0
        End If
    End If
End Function

Private Function ExtractFirstNumber(ByVal textData As String) As Long
    Dim i As Long
    Dim ch As String
    Dim token As String

    For i = 1 To Len(textData)
        ch = Mid$(textData, i, 1)

        If ch >= "0" And ch <= "9" Then
            token = token & ch
        ElseIf Len(token) > 0 Then
            Exit For
        End If
    Next i

    If Len(token) > 0 Then ExtractFirstNumber = CLng(token)
End Function

