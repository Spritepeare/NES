Private Function CellHasSourceContent(ByVal sourceCell As Range) As Boolean
    Dim formulaData As Variant
    Dim valueData As Variant

    formulaData = sourceCell.Formula
    valueData = sourceCell.Value2

    If IsError(valueData) Or IsError(formulaData) Then
        CellHasSourceContent = True
    ElseIf Not IsEmpty(formulaData) And Len(CStr(formulaData)) > 0 Then
        CellHasSourceContent = True
    ElseIf Not IsEmpty(valueData) And Len(CStr(valueData)) > 0 Then
        CellHasSourceContent = True
    End If
End Function

Private Function CellHasOutputContent(ByVal targetCell As Range) As Boolean
    Dim formulaData As Variant
    Dim valueData As Variant

    formulaData = targetCell.Formula
    valueData = targetCell.Value2

    If IsError(valueData) Or IsError(formulaData) Then
        CellHasOutputContent = True
    ElseIf Not IsEmpty(formulaData) And Len(CStr(formulaData)) > 0 Then
        CellHasOutputContent = True
    ElseIf Not IsEmpty(valueData) And Len(CStr(valueData)) > 0 Then
        CellHasOutputContent = True
    End If
End Function

Private Function GetCellText(ByVal sourceCell As Range) As String
    Dim valueData As Variant

    valueData = sourceCell.Value2

    If IsError(valueData) Or IsEmpty(valueData) Then
        GetCellText = vbNullString
    Else
        GetCellText = CStr(valueData)
    End If
