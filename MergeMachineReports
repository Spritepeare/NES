Private Sub CopyTemplateBlock( _
    ByVal sourceWS As Worksheet, ByVal sourceStart As Long, ByVal sourceEnd As Long, _
    ByVal targetWS As Worksheet, ByVal targetStart As Long)

    Dim sourceRange As Range, targetRange As Range
    Dim r As Long, targetRow As Long

    Set sourceRange = sourceWS.Range(sourceWS.Cells(sourceStart, 1), sourceWS.Cells(sourceEnd, 20))
    Set targetRange = targetWS.Range(targetWS.Cells(targetStart, 1), _
                                     targetWS.Cells(targetStart + sourceEnd - sourceStart, 20))

    sourceRange.Copy Destination:=targetRange

    '移除來源公式及外部連結，只保留目前計算結果與格式。
    targetRange.value = targetRange.value

    For r = sourceStart To sourceEnd
        targetRow = targetStart + r - sourceStart
        targetWS.Rows(targetRow).RowHeight = sourceWS.Rows(r).RowHeight
        targetWS.Rows(targetRow).Hidden = sourceWS.Rows(r).Hidden
    Next r
End Sub

Private Sub CopyColumnLayout( _
    ByVal sourceWS As Worksheet, ByVal targetWS As Worksheet, _
    ByVal firstColumn As Long, ByVal lastColumn As Long)

    Dim c As Long

    For c = firstColumn To lastColumn
        targetWS.Columns(c).ColumnWidth = sourceWS.Columns(c).ColumnWidth
        targetWS.Columns(c).Hidden = sourceWS.Columns(c).Hidden
    Next c
End Sub

Private Sub CopyRowValues( _
    ByVal sourceWS As Worksheet, ByVal sourceRow As Long, _
    ByVal targetWS As Worksheet, ByVal targetRow As Long, _
    ByVal firstColumn As Long, ByVal lastColumn As Long)

    Dim c As Long
    Dim present As Boolean
    Dim outputValue As Variant

    For c = firstColumn To lastColumn
        outputValue = GetCellValueForOutput(sourceWS.Cells(sourceRow, c), present)

        If present Then
            targetWS.Cells(targetRow, c).value = outputValue
        Else
            targetWS.Cells(targetRow, c).ClearContents
        End If
    Next c
End Sub

Private Function BuildOutputSheetName(ByVal twSheetName As String) As String
