        result = Left$(Trim$(twSheetName), Len(Trim$(twSheetName)) - 2) & "合併"
    Else
        result = twSheetName & "-合併"
    End If

    If Len(result) > 31 Then result = Left$(result, 31)
    BuildOutputSheetName = result
