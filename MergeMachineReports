Private Function FindDeviceBlock( _
    ByVal ws As Worksheet, ByVal displayDeviceName As String, _
    ByRef startRow As Long, ByRef endRow As Long) As Boolean

    Dim targetName As String
    Dim r As Long, candidateStart As Long
    Dim lastRow As Long

    startRow = 0
    endRow = 0
    lastRow = ws.Cells(ws.Rows.count, 1).End(xlUp).Row

    If NormalizeText(displayDeviceName) = NormalizeText("焊接Hanger") Then
        targetName = "Hanger 焊接"

        '附件內第一次出現的 Hanger 焊接才是焊接 Hanger 報表；
        '第二次出現位於精密車修區塊內。
        For r = 1 To lastRow
            If NormalizeText(GetCellText(ws.Cells(r, 1))) = NormalizeText(targetName) Then
                candidateStart = r
                'VBA 的 And 不會短路判斷；r=1 時不可讀取第 0 列。
                If r > 1 Then
                    If IsMonthHeaderRow(ws, r - 1) Then candidateStart = r - 1
                End If

                If FindBlockEnd(ws, candidateStart, endRow) Then
                    startRow = candidateStart
                    FindDeviceBlock = True
                    Exit Function
                End If
            End If
        Next r

    Else
        targetName = displayDeviceName

        For r = 1 To lastRow
            If NormalizeText(GetCellText(ws.Cells(r, 1))) = NormalizeText(targetName) Then
                If FindBlockEnd(ws, r, endRow) Then
                    startRow = r
                    FindDeviceBlock = True
                    Exit Function
                End If
            End If
        Next r
    End If
End Function

Private Function FindBlockEnd(ByVal ws As Worksheet, ByVal startRow As Long, ByRef endRow As Long) As Boolean
    Dim r As Long
    Dim maxSearchRow As Long

    maxSearchRow = Application.Min(ws.Cells(ws.Rows.count, 1).End(xlUp).Row, startRow + 45)

    For r = startRow To maxSearchRow
        If NormalizeText(GetCellText(ws.Cells(r, 1))) = NormalizeText("產能負荷率") Then
            endRow = r
            FindBlockEnd = True
            Exit Function
        End If
    Next r
End Function

Private Function BuildRowMap(ByVal ws As Worksheet, ByVal startRow As Long, ByVal endRow As Long) As Object
    Dim result As Object
    Dim r As Long
    Dim key As String

    Set result = CreateObject("Scripting.Dictionary")
    result.CompareMode = vbTextCompare

    For r = startRow To endRow
        key = NormalizeText(GetCellText(ws.Cells(r, 1)))

        If Len(key) > 0 Then
            If Not result.Exists(key) Then result.Add key, r
        End If
    Next r

    Set BuildRowMap = result
End Function

Private Function BuildForecastRowMap(ByVal ws As Worksheet, ByVal startRow As Long, ByVal endRow As Long) As Object
    Dim result As Object
    Dim r As Long
    Dim y As Long, m As Long
    Dim labelText As String

    Set result = CreateObject("Scripting.Dictionary")
    result.CompareMode = vbTextCompare

    For r = startRow To endRow
        labelText = GetCellText(ws.Cells(r, 1))

        If TryParseForecastLabel(labelText, y, m) Then
            result(FormatYearMonth(y, m)) = r
        End If
    Next r

    Set BuildForecastRowMap = result
End Function

Private Function FindMonthHeaderRow(ByVal ws As Worksheet, ByVal startRow As Long, ByVal endRow As Long) As Long
    Dim r As Long

    For r = startRow To endRow
        If IsMonthHeaderRow(ws, r) Then
            FindMonthHeaderRow = r
            Exit Function
        End If
    Next r
End Function

Private Function BuildPlannedCapacityMap(ByVal ws As Worksheet, ByVal startRow As Long, ByVal endRow As Long) As Object
    Dim result As Object
    Dim r As Long
    Dim slotIndex As Long
    Dim inCapacitySection As Boolean
    Dim labelText As String
    Dim key As String

    Set result = CreateObject("Scripting.Dictionary")
    result.CompareMode = vbTextCompare

    For r = startRow To endRow
        labelText = GetCellText(ws.Cells(r, 1))
        key = NormalizeText(labelText)

        If key = NormalizeText("當月實際下單跟上月預估") Then
            inCapacitySection = True

        ElseIf key = NormalizeText("當月實際生產產能") Then
            Exit For

        ElseIf inCapacitySection Then
            If IsPlannedCapacityCandidate(labelText) Then
                slotIndex = slotIndex + 1
                result(CStr(slotIndex)) = r
            End If
        End If
    Next r

    Set BuildPlannedCapacityMap = result
End Function

Private Function GetCapacitySlotForRow(ByVal capacityMap As Object, ByVal rowNumber As Long) As Long
    Dim key As Variant

    If capacityMap Is Nothing Then Exit Function

    For Each key In capacityMap.Keys
        If CLng(capacityMap(key)) = rowNumber Then
            GetCapacitySlotForRow = CLng(key)
            Exit Function
        End If
    Next key
End Function

Private Function IsPlannedCapacityCandidate(ByVal labelText As String) As Boolean
    Dim key As String

    key = NormalizeText(labelText)
    If Len(key) = 0 Then Exit Function

    '規劃產能區可能出現：
    '一班產能、兩班產能、三班產能、一班+加班產能、
    '加班最大產量、7/14討論一個月產量、單純「一班」或「產能」等名稱。
    If InStr(1, key, NormalizeText("產能"), vbTextCompare) > 0 Then
        IsPlannedCapacityCandidate = True
        Exit Function
    End If

    If InStr(1, key, NormalizeText("產量"), vbTextCompare) > 0 Then
        IsPlannedCapacityCandidate = True
        Exit Function
    End If

    If key = NormalizeText("一班") _
       Or key = NormalizeText("兩班") _
       Or key = NormalizeText("三班") Then
        IsPlannedCapacityCandidate = True
    End If
End Function

Private Function FindSheetBySuffix(ByVal wb As Workbook, ByVal suffix As String) As Worksheet
    Dim ws As Worksheet
    Dim found As Worksheet
    Dim matchedCount As Long
    Dim sheetKey As String, suffixKey As String

    suffixKey = UCase$(Trim$(suffix))

    For Each ws In wb.Worksheets
        sheetKey = UCase$(Trim$(ws.Name))

        If Len(sheetKey) >= Len(suffixKey) Then
            If Right$(sheetKey, Len(suffixKey)) = suffixKey Then
                matchedCount = matchedCount + 1
                Set found = ws
            End If
        End If
    Next ws

    If matchedCount > 1 Then
        Err.Raise vbObjectError + 1010, , "找到多張名稱後綴為 " & suffix & " 的分頁，無法判斷來源。"
    End If

    Set FindSheetBySuffix = found
End Function

Private Function WorksheetExists(ByVal wb As Workbook, ByVal sheetName As String) As Boolean
    Dim ws As Worksheet

    On Error Resume Next
    Set ws = wb.Worksheets(sheetName)
    WorksheetExists = Not ws Is Nothing
    On Error GoTo 0
End Function

'============================================================
' 設備清單與排序
'============================================================
Private Function GetSortedDevices(ByVal wb As Workbook) As Variant
    Dim sourceList As Variant
    Dim result() As Variant
    Dim wsTemp As Worksheet
    Dim tempName As String
    Dim i As Long, itemCount As Long

    '沖壓、自供料依使用者指示排除。
    sourceList = Array( _
        "14B", "17B", "19B", "精密車修", "13B", _
        "2分", "2分半", "2模3", "32B", "36B", "38B", _
        "22B", "分半車", "10B", "27B", "Hanger", _
        "焊接Hanger", "彈簧機CS01+CS03", "彈簧機CS02", "24B")

    itemCount = UBound(sourceList) - LBound(sourceList) + 1
    tempName = "__設備排序_" & Format$(Now, "hhmmss")

    On Error GoTo SortError

    Set wsTemp = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.count))
    wsTemp.Name = Left$(tempName, 31)

    For i = LBound(sourceList) To UBound(sourceList)
        wsTemp.Cells(i - LBound(sourceList) + 1, 1).value = sourceList(i)
    Next i

    wsTemp.Range("A1:A" & itemCount).Sort _
        Key1:=wsTemp.Range("A1"), _
        Order1:=xlAscending, _
        Header:=xlNo, _
        OrderCustom:=1, _
        MatchCase:=False, _
        Orientation:=xlTopToBottom, _
        SortMethod:=xlPinYin, _
        DataOption1:=xlSortNormal

    ReDim result(0 To itemCount - 1)

    For i = 1 To itemCount
        result(i - 1) = CStr(wsTemp.Cells(i, 1).value)
    Next i

    Application.DisplayAlerts = False
    wsTemp.Delete
    Set wsTemp = Nothing

    GetSortedDevices = result
    Exit Function

SortError:
    If Not wsTemp Is Nothing Then
        Application.DisplayAlerts = False
        wsTemp.Delete
    End If
    Err.Raise Err.Number, Err.Source, Err.Description
End Function

