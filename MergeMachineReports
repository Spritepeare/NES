    hasContent = CellHasSourceContent(sourceCell)
    valueData = sourceCell.Value2

    If IsError(valueData) Then
        GetNumericCellValue = 0
    ElseIf IsNumeric(valueData) And Len(CStr(valueData)) > 0 Then
        GetNumericCellValue = CDbl(valueData)
    Else
        GetNumericCellValue = 0
    End If
