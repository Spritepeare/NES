Private Function ParseSwitchWeek( _
    ByVal value As Variant, _
    ByVal sheetRow As Long) As Long

    Dim textValue As String
    Dim yearValue As Long
    Dim weekValue As Long

    If IsError(value) Then
        Err.Raise vbObjectError + 1070, "ParseSwitchWeek", _
                  "第 " & sheetRow & " 列：K欄切換週為Excel錯誤值。"
    End If

    textValue = UCase$(Trim$(CStr(value)))

    If textValue = "" Or textValue = "0" Then
        ParseSwitchWeek = NO_SWITCH_WEEK
        Exit Function
    End If

    If Len(textValue) <> 7 Or Mid$(textValue, 5, 1) <> "W" Then
        Err.Raise vbObjectError + 1071, "ParseSwitchWeek", _
                  "第 " & sheetRow & _
                  " 列：K欄格式必須為YYYYWww，例如2026W40。"
    End If

    If Not IsNumeric(Left$(textValue, 4)) Or _
       Not IsNumeric(Right$(textValue, 2)) Then

        Err.Raise vbObjectError + 1072, "ParseSwitchWeek", _
                  "第 " & sheetRow & _
                  " 列：K欄格式必須為YYYYWww，例如2026W40。"
    End If

    yearValue = CLng(Left$(textValue, 4))
    weekValue = CLng(Right$(textValue, 2))

    If weekValue < 1 Or weekValue > 53 Then
        Err.Raise vbObjectError + 1073, "ParseSwitchWeek", _
                  "第 " & sheetRow & " 列：K欄週數必須介於01～53。"
    End If

    ParseSwitchWeek = MakeWeekSerial(yearValue, weekValue)
End Function

Private Function GetArrivalOriginBySerial( _
    ByVal arrivalWeekSerial As Long, _
    ByVal switchedOrigin As String, _
    ByVal switchWeekSerial As Long) As String

    If switchWeekSerial = NO_SWITCH_WEEK Then
        GetArrivalOriginBySerial = "TW"
        Exit Function
    End If

    If arrivalWeekSerial >= switchWeekSerial Then
        GetArrivalOriginBySerial = switchedOrigin
    Else
        GetArrivalOriginBySerial = "TW"
    End If
End Function

