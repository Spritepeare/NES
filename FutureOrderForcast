Private Function FindFirstNegativeWeek(ByRef curve() As Double) As Long

    Dim weekIndex As Long

    For weekIndex = LBound(curve) To UBound(curve)

        If curve(weekIndex) < 0# Then
            FindFirstNegativeWeek = weekIndex
            Exit Function
        End If
    Next weekIndex

    FindFirstNegativeWeek = -1
End Function

Private Function RoundUpToBatch( _
    ByVal requiredQuantity As Double, _
    ByVal batchSize As Double) As Double

    Dim ratio As Double
    Dim batchCount As Long

    If batchSize <= 0# Then batchSize = DEFAULT_BATCH

    If requiredQuantity <= 0# Then
        RoundUpToBatch = batchSize
        Exit Function
    End If

    ratio = requiredQuantity / batchSize
    batchCount = CLng(Int(ratio))

    If ratio - CDbl(batchCount) > 0.0000000001 Then
        batchCount = batchCount + 1
    End If

    If batchCount < 1 Then batchCount = 1

    RoundUpToBatch = CDbl(batchCount) * batchSize
End Function

Private Function CeilingToLong(ByVal value As Double) As Long

    Dim integerPart As Long

    integerPart = CLng(Int(value))

    If value - CDbl(integerPart) > 0.0000000001 Then
        integerPart = integerPart + 1
    End If

    CeilingToLong = integerPart
End Function

Private Function EmptyToZero(ByVal value As Variant) As Double

    If IsEmpty(value) Or Len(Trim$(CStr(value))) = 0 Then
        EmptyToZero = 0#
    Else
        EmptyToZero = CDbl(value)
    End If
End Function

