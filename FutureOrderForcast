Private Sub DeleteSheetIfExists( _
    ByVal wb As Workbook, _
    ByVal sheetName As String)

    Dim ws As Worksheet

    On Error Resume Next
    Set ws = wb.Worksheets(sheetName)
    On Error GoTo 0

    If Not ws Is Nothing Then ws.Delete
End Sub

Private Function CopyOutputSheet( _
    ByVal sourceSheet As Worksheet, _
    ByVal newSheetName As String) As Worksheet

    sourceSheet.Copy _
        After:=sourceSheet.Parent.Worksheets(sourceSheet.Parent.Worksheets.count)

    Set CopyOutputSheet = _
        sourceSheet.Parent.Worksheets(sourceSheet.Parent.Worksheets.count)

    CopyOutputSheet.Name = newSheetName
End Function

Private Sub WriteOutput( _
    ByVal ws As Worksheet, _
    ByRef outputData As Variant, _
    ByVal startStockCol As Long, _
    ByVal firstWeekCol As Long, _
    ByVal lastWeekCol As Long, _
    ByVal lastClearCol As Long, _
    ByVal lastDataRow As Long)

    'P類型的起始欄、真正週欄與後方輔助欄全部清內容，
    '但保留原有格式。
    ws.Range( _
        ws.Cells(FIRST_DATA_ROW, startStockCol), _
        ws.Cells(lastDataRow, lastClearCol)).ClearContents

    '訂單寫入完整時間軸，包含原本標示為「輔助欄」的後續週數。
    ws.Range( _
        ws.Cells(FIRST_DATA_ROW, firstWeekCol), _
        ws.Cells(lastDataRow, lastWeekCol)).Value2 = outputData
End Sub

Private Function ElapsedTimeSeconds(ByVal startTime As Double) As Double

    Dim currentTime As Double
    currentTime = Timer

    If currentTime >= startTime Then
        ElapsedTimeSeconds = currentTime - startTime
    Else
        ElapsedTimeSeconds = (86400# - startTime) + currentTime
    End If
End Function
