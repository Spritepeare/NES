Private Function ReadBatchSize(ByVal value As Variant) As Double

    If IsError(value) Then
        ReadBatchSize = DEFAULT_BATCH
    ElseIf Len(Trim$(CStr(value))) = 0 Then
        ReadBatchSize = DEFAULT_BATCH
    ElseIf Not IsNumeric(value) Then
        ReadBatchSize = DEFAULT_BATCH
    ElseIf CDbl(value) <= 0# Then
        ReadBatchSize = DEFAULT_BATCH
    Else
        ReadBatchSize = CDbl(value)
    End If
End Function

